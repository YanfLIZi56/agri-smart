<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agriSmart.monitor.mapper.MonitorJobMapper">
    
    <resultMap type="MonitorJob" id="MonitorJobResult">
        <result property="id"    column="id"    />
        <result property="monitorId"    column="monitor_id"    />
        <result property="monitorName"    column="monitor_name"    />
        <result property="monitorType"    column="monitor_type"    />
        <result property="modelConfigId"    column="model_config_id"    />
        <result property="modelName"    column="model_name"    />
        <result property="modelVersion"    column="model_version"    />
        <result property="modelConfigIsDel"    column="model_config_is_del"    />
        <result property="modelConfigIsActive"    column="model_config_is_active"    />
        <result property="duration"    column="duration"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMonitorJobVo">
        select a.id, a.monitor_id, a.model_config_id, a.duration, a.status, a.create_time, a.end_time, a.remark,
               b.name as monitor_name, b.monitor_type,
               c.model_name as model_name, c.version as model_version,
               c.is_del as model_config_is_del, c.is_active as model_config_is_active
        from monitor_job a
            join monitor b on a.monitor_id = b.id
            join model_config c on a.model_config_id = c.id
    </sql>

    <select id="selectMonitorJobList" parameterType="MonitorJob" resultMap="MonitorJobResult">
        <include refid="selectMonitorJobVo"/>
        <where>  
            <if test="monitorId != null "> and a.monitor_id = #{monitorId}</if>
            <if test="modelConfigId != null "> and a.model_config_id = #{modelConfigId}</if>
            <if test="status != null "> and a.status = #{status}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != '' and params.endCreateTime != null and params.endCreateTime != ''"> and a.create_time between #{params.beginCreateTime} and #{params.endCreateTime}</if>
            <if test="params.beginEndTime != null and params.beginEndTime != '' and params.endEndTime != null and params.endEndTime != ''"> and a.end_time between #{params.beginEndTime} and #{params.endEndTime}</if>
        </where>
    </select>
    
    <select id="selectMonitorJobById" parameterType="Long" resultMap="MonitorJobResult">
        <include refid="selectMonitorJobVo"/>
        where a.id = #{id}
    </select>

    <insert id="insertMonitorJob" parameterType="MonitorJob" useGeneratedKeys="true" keyProperty="id">
        insert into monitor_job
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="monitorId != null">monitor_id,</if>
            <if test="modelConfigId != null">model_config_id,</if>
            <if test="duration != null">duration,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="monitorId != null">#{monitorId},</if>
            <if test="modelConfigId != null">#{modelConfigId},</if>
            <if test="duration != null">#{duration},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMonitorJob" parameterType="MonitorJob">
        update monitor_job
        <trim prefix="SET" suffixOverrides=",">
            <if test="monitorId != null">monitor_id = #{monitorId},</if>
            <if test="modelConfigId != null">model_config_id = #{modelConfigId},</if>
            <if test="duration != null">duration = #{duration},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMonitorJobById" parameterType="Long">
        delete from monitor_job where id = #{id}
    </delete>

    <delete id="deleteMonitorJobByIds" parameterType="String">
        delete from monitor_job where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>