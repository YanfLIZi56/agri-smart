<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agriSmart.monitor.mapper.MonitorMapper">
    
    <resultMap type="Monitor" id="MonitorResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="rtspUrl"    column="rtsp_url"    />
        <result property="monitorType"    column="monitor_type"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMonitorVo">
        select id, name, rtsp_url, monitor_type, status, create_time, update_time, remark from monitor
    </sql>

    <select id="selectMonitorList" parameterType="Monitor" resultMap="MonitorResult">
        <include refid="selectMonitorVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectMonitorById" parameterType="Long" resultMap="MonitorResult">
        <include refid="selectMonitorVo"/>
        where id = #{id}
    </select>

    <insert id="insertMonitor" parameterType="Monitor" useGeneratedKeys="true" keyProperty="id">
        insert into monitor
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="rtspUrl != null and rtspUrl != ''">rtsp_url,</if>
            <if test="monitorType != null and monitorType != ''">monitor_type,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="rtspUrl != null and rtspUrl != ''">#{rtspUrl},</if>
            <if test="monitorType != null and monitorType != ''">#{monitorType},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateMonitor" parameterType="Monitor">
        update monitor
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="rtspUrl != null and rtspUrl != ''">rtsp_url = #{rtspUrl},</if>
            <if test="monitorType != null and monitorType != ''">monitor_type = #{monitorType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>
    <update id="updateMonitorStatus">
        update monitor set status = #{status} where id = #{id}
    </update>

    <delete id="deleteMonitorById" parameterType="Long">
        delete from monitor where id = #{id}
    </delete>

    <delete id="deleteMonitorByIds" parameterType="String">
        delete from monitor where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>