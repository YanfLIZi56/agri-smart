<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agriSmart.crop.mapper.CropMapper">
    
    <resultMap type="Crop" id="CropResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="alias"    column="alias"    />
        <result property="symptoms"    column="symptoms"    />
        <result property="causes"    column="causes"    />
        <result property="prevention"    column="prevention"    />
        <result property="varietyId"    column="variety_id"    />
        <result property="varietyName"    column="variety_name"    />
        <result property="status"    column="status"    />
        <result property="images"    column="images"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectCropVo">
        select a.id, a.name, alias, symptoms, causes, prevention, variety_id, b.name as variety_name, status, images,a.create_time, a.update_time
        from crop a left join variety  b on b.id = a.variety_id
    </sql>

    <select id="selectCropList" parameterType="Crop" resultMap="CropResult">
        <include refid="selectCropVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="alias != null  and alias != ''"> and alias like concat('%', #{alias}, '%')</if>
            <if test="varietyId != null "> and variety_id = #{varietyId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="params.beginUpdateTime != null and params.beginUpdateTime != '' and params.endUpdateTime != null and params.endUpdateTime != ''"> and update_time between #{params.beginUpdateTime} and #{params.endUpdateTime}</if>
        </where>
    </select>
    
    <select id="selectCropById" parameterType="Long" resultMap="CropResult">
        <include refid="selectCropVo"/>
        where a.id = #{id}
    </select>

    <select id="getIdByLabel" resultMap="CropResult">
        select a.id, a.name, alias, variety_id, b.name as variety_name, status
        from crop a left join variety  b on b.id = a.variety_id
        <where>
            <if test="aliases != null and aliases.size() > 0">
                alias in
                <foreach item="alias" collection="aliases" separator="," open="(" close=")">
                    #{alias}
                </foreach>
            </if>
        </where>
    </select>

    <insert id="insertCrop" parameterType="Crop" useGeneratedKeys="true" keyProperty="id">
        insert into crop
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="alias != null">alias,</if>
            <if test="symptoms != null">symptoms,</if>
            <if test="causes != null">causes,</if>
            <if test="prevention != null">prevention,</if>
            <if test="varietyId != null">variety_id,</if>
            <if test="status != null">status,</if>
            <if test="images != null">images,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="alias != null">#{alias},</if>
            <if test="symptoms != null">#{symptoms},</if>
            <if test="causes != null">#{causes},</if>
            <if test="prevention != null">#{prevention},</if>
            <if test="varietyId != null">#{varietyId},</if>
            <if test="status != null">#{status},</if>
            <if test="images != null">#{images},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateCrop" parameterType="Crop">
        update crop
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="alias != null">alias = #{alias},</if>
            <if test="symptoms != null">symptoms = #{symptoms},</if>
            <if test="causes != null">causes = #{causes},</if>
            <if test="prevention != null">prevention = #{prevention},</if>
            <if test="varietyId != null">variety_id = #{varietyId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="images != null">images = #{images},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCropById" parameterType="Long">
        delete from crop where id = #{id}
    </delete>

    <delete id="deleteCropByIds" parameterType="String">
        delete from crop where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>